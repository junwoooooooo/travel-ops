# 실제 값은 .env에만. 이 파일은 키 목록만 유지한다.
POSTGRES_USER=travelops
POSTGRES_PASSWORD=
POSTGRES_DB=travelops

# 컨테이너에서 실행할 때는 호스트가 postgres, 로컬 uvicorn(세션 4)에서는 localhost
DATABASE_URL=postgresql+asyncpg://travelops:__PASSWORD__@postgres:5432/travelops

# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
