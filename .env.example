# 실제 값은 .env에만. 이 파일은 키 목록만 유지한다.
POSTGRES_USER=travelops
POSTGRES_PASSWORD=
POSTGRES_DB=travelops

# 기준은 하이브리드 개발(호스트 uvicorn → 도커 postgres)이라 localhost다.
# 풀도커일 때 필요한 @postgres 주소는 docker-compose.yml의 api.environment가 덮어쓰므로 여기 적지 않는다.
# 서버(EC2)에서는 RDS 엔드포인트를 여기에 직접 적는다 — prod 조립도는 덮어쓰지 않는다 (ADR-0005).
DATABASE_URL=postgresql+asyncpg://travelops:__PASSWORD__@localhost:5432/travelops

# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# DATABASE_URL과 같은 규칙이다 — 여기는 하이브리드 기준 localhost이고,
# 풀도커의 @redis 주소는 docker-compose.yml의 api.environment가 덮어쓴다 (ADR-0005).
REDIS_URL=redis://localhost:6379/0

# https://developers.kakao.com 앱 > 앱 키 > REST API 키. 비어 있어도 앱은 뜨고,
# 장소 검색을 부르는 순간에만 KakaoNotConfigured로 실패한다 (ADR-0010)
KAKAO_REST_API_KEY=
